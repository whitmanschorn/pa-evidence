# Copy to .env (gitignored). `make tokens` fills in AUTH_TOKENS for you.
# No secret belongs in this file or anywhere else in the repository.

# --- HTTP server -------------------------------------------------------------
# Port the API (and the /ui bundle) listens on.
PORT=8080
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- FHIR server -------------------------------------------------------------
# Base URL of the FHIR R4 server. Inside compose the API reaches HAPI by service name.
FHIR_BASE_URL=http://hapi:8080/fhir
# How the FHIR client authenticates: none (local HAPI) | bearer | smart
FHIR_AUTH=none
# Used only when FHIR_AUTH=bearer. A static access token for the FHIR server.
FHIR_BEARER_TOKEN=

# Used only when FHIR_AUTH=smart (SMART Backend Services, client-credentials with a signed JWT assertion).
# Token endpoint of the authorization server.
SMART_TOKEN_URL=
# Client id registered with the authorization server (becomes iss and sub of the assertion).
SMART_CLIENT_ID=
# Path to the PEM private key that signs the client assertion. Keep it outside the repository.
SMART_PRIVATE_KEY_PATH=
# Key id (kid) of that key, as published in the client's JWKS.
SMART_KEY_ID=
# Signing algorithm for the assertion: RS384 | ES384
SMART_ALG=RS384
# Space-separated scopes to request.
SMART_SCOPES="system/Patient.rs system/Condition.rs system/Observation.rs system/MedicationRequest.rs system/AllergyIntolerance.rs"

# --- Local model (Ollama, running natively on the host) -----------------------
# From inside a container the host's Ollama is host.docker.internal. Ollama itself listens on 127.0.0.1 only.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama server version the service was tested against. /ready reports a mismatch.
OLLAMA_EXPECTED_VERSION=0.40.11
# Which model (pinned by digest), its prompts, call settings, output caps and timeouts: one folder per version,
# <effective date>_<version>, and the latest one in effect today is used. A new model is a new folder, picked up by
# `make reload-models`. See data/models/ and apps/api/src/core/llm/modelVersions.ts.
MODELS_DIR=data/models

# --- Caller authentication (demo) ---------------------------------------------
# Comma-separated role:subject:sha256(token) entries. Only hashes live here; plaintext goes to .tokens.local.
# Generated by `make tokens`. Example shape (not real hashes):
# AUTH_TOKENS=nurse:nurse-1:<64 hex>,admin:admin-1:<64 hex>,probe:probe-1:<64 hex>
AUTH_TOKENS=
# The probe role's own token (health:read only), so the container healthcheck can call /health. Written by `make tokens`.
PROBE_TOKEN=

# --- Storage and data ---------------------------------------------------------
# SQLite file for the append-only audit store.
AUDIT_DB_PATH=var/audit.db
# Policies, one folder per policy id, one subfolder per version: <policy id>/<effective date>_<version>/ holding
# policy.json and rules-engine-config.json (values the policy has no field for). An update is a new version folder.
POLICIES_DIR=data/policies
# Curated code sets (descendants and display fallbacks), one file per policy code.
TERMINOLOGY_DIR=data/terminology
# Comma-separated directories of request-form JSON files.
REQUESTS_DIRS=data/requests,eval/synthea-requests
# Directory of the built web app, served at /ui.
UI_DIR=apps/web/dist

# --- Scripts (run on the host, not in a container) ----------------------------
# FHIR base URL the loader (`pnpm load`, `make up`) posts bundles to: HAPI's host-only port.
FHIR_LOAD_URL=http://localhost:8090/fhir
