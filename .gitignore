# dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# secrets: token hashes and plaintext tokens are generated by `make tokens`
.env
.tokens.local
*.pem
*.key

# fetched Synthea sample (pinned URL + sha256 in data/synthea/)
data/synthea/cache/

# local state (audit database, HAPI volume exports)
var/
*.db
*.db-journal
*.db-wal
*.db-shm

# Playwright output: the HTML report (pnpm test:ui:report) and per-test screenshots and traces
apps/web/test-results/
apps/web/playwright-report/

# OS / editor
.DS_Store
.vscode/
.idea/

# Eval outputs describe one machine's run, so they are never committed: pnpm eval, pnpm eval:models and pnpm eval:report write
# them again on whatever machine runs them (D-091). The inputs and judgments (eval/expected/, eval/synthea-*, findings.json,
# hand-audit.json) are committed.
EVAL.md
EVAL.html
eval/results/*
!eval/results/.gitkeep
