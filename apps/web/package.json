{
  "name": "@pa/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ui": "PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/ui playwright test --project=ui --output=test-results/ui",
    "test:e2e": "E2E=1 PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/e2e playwright test --project=e2e --output=test-results/e2e",
    "test:ui:report": "playwright show-report playwright-report/ui",
    "test:e2e:report": "playwright show-report playwright-report/e2e"
  },
  "dependencies": {
    "@mantine/charts": "9.7.2",
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@pa/shared": "workspace:*",
    "@tabler/icons-react": "3.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "swr": "2.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
